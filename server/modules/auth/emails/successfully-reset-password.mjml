<mjml>
  <mj-head>
    <mj-title>Password reset successful</mj-title>
    <mj-preview
      >Your YummyHouse password has been successfully reset</mj-preview
    >

    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#555555" line-height="1.6" />
      <mj-button
        background-color="#ff6b6b"
        color="#ffffff"
        border-radius="6px"
      />
    </mj-attributes>

    <mj-style inline="inline"> .container { max-width: 500px; } </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    <!-- Header -->
    {{> header }}

    <!-- Main Card -->
    <mj-section
      css-class="container"
      background-color="#ffffff"
      padding="20px"
      border-radius="8px"
    >
      <mj-column>
        <mj-text> Hello {{ name }}, </mj-text>

        <mj-text> ✓ Your password has been successfully reset. </mj-text>

        <mj-text>
          You can now log in to your YummyHouse account with your new password.
        </mj-text>

        <mj-button href="{{login_url}}" width="100%"> Log In </mj-button>

        <mj-text>
          If you didn't request this password reset or have any concerns about
          your account security, please contact our support team immediately.
        </mj-text>

        <mj-divider border-color="#eeeeee" />

        <mj-text font-size="12px" color="#999999">
          If the button doesn't work, copy and paste this link into your
          browser:
        </mj-text>

        <mj-text font-size="12px" color="#ff7a00"> {{login_url}} </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="10px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#aaaaaa">
          © {{year}} YummyHouse. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
