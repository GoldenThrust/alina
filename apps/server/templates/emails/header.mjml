<mj-section
  background-url="{{advert-img}}"
  background-size="cover"
  background-repeat="no-repeat"
  border-radius="8px 8px 0 0"
>
  <mj-column>
    <!-- Logo -->
    <mj-image
      src="{{logo}}"
      alt="Alina Logo"
      width="60px"
      padding="20px 0 10px"
    />
    <mj-image
      src="{{logo-text}}"
      alt="Alina Logo Lettermark"
      width="155px"
    />
  </mj-column>
</mj-section>
