<mjml>
  <mj-head>
    <mj-title>Reset your Alina password</mj-title>
    <mj-preview
      >Password reset instructions for your Alina account</mj-preview
    >

    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#555555" line-height="1.6" />
      <mj-button
        background-color="#ff6b6b"
        color="#ffffff"
        border-radius="6px"
      />
    </mj-attributes>

    <mj-style inline="inline"> .container { max-width: 500px; } </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    {{> header }}

    <mj-section
      css-class="container"
      background-color="#ffffff"
      padding="20px"
      border-radius="8px"
    >
      <mj-column>
        <mj-text> Hello {{ name }}, </mj-text>

        <mj-text>
          We received a request to reset your Alina password.
        </mj-text>

        <mj-text> Click the button below to set a new password: </mj-text>

        <mj-button href="{{reset_link}}" width="100%">
          Reset Password
        </mj-button>

        <mj-text>
          This link will expire in
          <strong>{{ expiry_minutes }} minutes</strong>.
        </mj-text>

        <mj-text>
          If you didn't request this, you can safely ignore this email
        </mj-text>

        <mj-divider border-color="#eeeeee" />

        <mj-text font-size="12px" color="#999999">
          If the button doesn't work, copy and paste this link into your
          browser:
        </mj-text>

        <mj-text font-size="12px" color="#ff7a00"> {{ reset_link }} </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="10px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#aaaaaa">
          © {{ year }} Alina. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
