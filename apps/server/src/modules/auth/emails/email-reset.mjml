<mjml>
  <mj-head>
    <mj-title>YummyHouse Account Email Changed</mj-title>
    <mj-preview>Your email address has been successfully updated</mj-preview>

    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#555555" line-height="1.6" />
      <mj-button
        background-color="#4caf50"
        color="#ffffff"
        border-radius="6px"
      />
    </mj-attributes>

    <mj-style inline="inline"> .container { max-width: 500px; } </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    {{> header }}

    <mj-section
      css-class="container"
      background-color="#ffffff"
      padding="20px"
      border-radius="8px"
    >
      <mj-column>
        <mj-text> Hello {{ name }}, </mj-text>

        <mj-text>
          <strong>✓ Email Change Confirmed</strong>
        </mj-text>

        <mj-text>
          Your YummyHouse account email address has been successfully updated.
        </mj-text>

        <mj-text>
          This email is being sent to your previous email address for your
          records. You should use your new email address to log in from now on.
        </mj-text>

        <mj-divider border-color="#eeeeee" />

        <mj-text font-size="12px" color="#999999">
          Did not authorize this change? If you believe your account has been
          compromised, please contact our support team immediately or click the
          button below to revert the email change.
        </mj-text>

        <mj-button
          href="{{revert_link}}"
          width="100%"
          background-color="#ff9800"
          color="#ffffff"
        >
          Cancel Email Change
        </mj-button>

        <mj-text font-size="12px" color="#999999">
          If the button doesn't work, copy and paste this link into your
          browser:
        </mj-text>

        <mj-text font-size="12px" color="#ff7a00"> {{ revert_link }} </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="10px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#aaaaaa">
          © {{ year }} YummyHouse. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
