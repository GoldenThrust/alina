<mjml>
  <mj-head>
    <mj-title>Verify your YummyHouse account</mj-title>
    <mj-preview>Confirm your email to start using YummyHouse</mj-preview>

    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#555555" line-height="1.6" />
      <mj-button
        background-color="#ff6b6b"
        color="#ffffff"
        border-radius="6px"
      />
    </mj-attributes>

    <mj-style inline="inline"> .container { max-width: 500px; } </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    <!-- Header -->
    {{> header }}

    <!-- Main Card -->
    <mj-section
      css-class="container"
      background-color="#ffffff"
      padding="20px"
      border-radius="8px"
    >
      <mj-column>
        <mj-text> Hello {{name}}, </mj-text>

        <mj-text> Welcome to YummyHouse! 🎉 </mj-text>

        <mj-text>
          Please confirm your email address by clicking the button below:
        </mj-text>

        <mj-button href="{{verification_link}}" width="100%">
          Verify Account
        </mj-button>

        <mj-text>
          This link will expire in <strong>{{expiry_minutes}} minutes</strong>.
        </mj-text>

        <mj-text>
          If you didn't create an account, you can safely ignore this email.
        </mj-text>

        <mj-divider border-color="#eeeeee" />

        <mj-text font-size="12px" color="#999999">
          If the button doesn’t work, copy and paste this link into your
          browser:
        </mj-text>

        <mj-text font-size="12px" color="#ff7a00">
          {{verification_link}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="10px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#aaaaaa">
          © {{year}} YummyHouse. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
