model SkinAnalysis {

  id                 String @id @default(cuid())

  scanId             String @unique

  scan               SkinScan @relation(fields:[scanId], references:[id])

  score               Float?

  skinAge              Int?

  redness          Float?

  ageSpot          Float?

  radiance          Float?

  moisture          Float?

  darkCircle         Float?

  eyeBag        Float?

  droopyUpperEyelid    Float?

  droopyLowerEyelid    Float?

  firmness          Float?

  texture          Json?

  acne          Float?

  pore              Json?

  wrinkle          Json?

  tearThrough          Float?

  skinType          String?

  rawResult          Json?

}

