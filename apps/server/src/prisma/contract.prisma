// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String?
  phoneNumber         String?              
  image               String?             
  emailVerifiedAt     DateTime?            
  gender              Gender?
  dateOfBirth         DateTime? 
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum Gender {
  male
  female
}
