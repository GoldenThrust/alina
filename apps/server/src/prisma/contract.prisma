// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName      String
  password  String?
  phoneNumber         String?              
  emailVerifiedAt     DateTime?            
  gender              Gender?
  dateOfBirth         DateTime? 
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  avatar        String?

  skinType      String?
  skinTone      String?

  lastScanImage String?

  lastInteractionId String?

  role          UserRole @default(USER)

  scans         SkinScan[]
  routines      Routine[]
  messages Message[]
  preferences   Preference?
  subscriptions Subscription[]
  orders        Order[]
  devices       ConnectedDevice[]

  sessions  Session[]
  oauthAccounts       OAuthAccount[]
}


model Session {
  id            String    @id @default(uuid())
  userId        String
  refreshSecret String
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}


model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerId])
  @@index([userId])
}


model SkinScan {
  id              String   @id @default(uuid())

  userId          String
  user            User @relation(fields:[userId], references:[id])

  status          ScanStatus

  score           Float?
  skinAge         Int?

  aiSummary       String?

  aiShortSummary  String?

  aiObservation   String?

  aiShortObservation String?

  image          String?

  createdAt       DateTime @default(now())

  analysis        SkinAnalysis?

}

model SkinAnalysis {

  id                 String @id @default(uuid())

  scanId             String @unique

  scan               SkinScan @relation(fields:[scanId], references:[id])

  redness          Float?

  ageSpot          Float?

  radiance          Float?

  moisture          Float?

  oiliness          Float?

  darkCircle         Float?

  eyeBag        Float?

  droopyUpperEyelid    Float?

  droopyLowerEyelid    Float?

  firmness          Float?

  texture          Json?

  acne          Float?

  pore              Json?

  wrinkle          Json?

  tearTrough          Float?

  skinType          Json?

  createdAt       DateTime @default(now())
}

model Routine {

  id            String @id @default(uuid())

  userId        String

  user          User @relation(fields:[userId], references:[id])

  title         String

  createdAt     DateTime @default(now())

  steps         RoutineStep[]

  recommendation Recommendation?
}

model RoutineStep {

  id            String @id @default(uuid())

  routineId     String

  routine       Routine @relation(fields:[routineId], references:[id])

  period        RoutinePeriod

  title         String

  instruction   String

  position      Int
}

model RoutineLog {

  id            String @id @default(uuid())

  userId        String

  routineId     String

  completedAt   DateTime

}

model Product {

  id              String @id @default(uuid())

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  name            String

  brand           String

  category        ProductCategory

  description     String

  image           String?

  affiliateUrl    String?

  price           Float?

  recommendation Recommendation?

  createdAt       DateTime @default(now())
}

model Recommendation {

  id              String @id @default(uuid())

  userId          String

  user            User @relation(fields:[userId], references:[id])

  scanId          String?

  type            RecommendationType

  explanation     String

  accepted       Boolean @default(false)

  productId       String?  @unique

  product         Product? @relation(fields:[productId], references:[id])

  routineId       String?  @unique

  routine         Routine? @relation(fields:[routineId], references:[id])

  createdAt       DateTime @default(now())

}


model Message {

  id            String @id @default(uuid())

  userId        String

  user          User @relation(fields:[userId], references:[id])

  sender        Sender

  content       String

  createdAt     DateTime @default(now())

}

model Preference {

  id                String @id @default(uuid())

  userId            String @unique

  user              User @relation(fields:[userId], references:[id])

  favoriteBrands    String[]

  favoriteIngredients String[]

  avoidedIngredients String[]

  budget            Int?

}

model Order {

  id              String @id @default(uuid())

  userId          String

  user            User @relation(fields:[userId], references:[id])

  total           Float

  paypalOrderId   String?

  createdAt       DateTime @default(now())

  items           OrderItem[]
}

model OrderItem {

  id            String @id @default(uuid())

  orderId       String

  order         Order @relation(fields:[orderId], references:[id])

  productId     String

  product       Product @relation(fields:[productId], references:[id])

  quantity      Int

}

model ConnectedDevice {

  id            String @id @default(uuid())

  userId        String

  user          User @relation(fields:[userId], references:[id])

  type          DeviceType

  externalId    String

  name          String

}

model Subscription {

  id              String @id @default(uuid())

  userId          String

  user            User @relation(fields:[userId], references:[id])

  plan            SubscriptionPlan

  status          SubscriptionStatus

  startedAt       DateTime

  expiresAt       DateTime?
}


enum Gender {
  MALE
  FEMALE
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RoutinePeriod {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
  HABIT
}

enum RecommendationType {
  PRODUCT
  ROUTINE
  HABIT
}

enum Sender {
  USER
  ALINA
}

enum DeviceType {
  RING
  MOBILE
  WEB
}

enum SubscriptionPlan {
  FREE
  PLUS
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ProductCategory {
  CLEANSER
  TONER
  SERUM
  MOISTURIZER
  SUNSCREEN
  TREATMENT
  OTHER
}

enum UserRole {
  USER
  ADMIN
}