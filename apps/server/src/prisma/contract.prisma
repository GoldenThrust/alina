// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  phoneNumber         String?              
  image               String?             
  emailVerifiedAt     DateTime?            
  gender              Gender?
  dateOfBirth         DateTime? 
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  sessions  Session[]
  oauthAccounts       OAuthAccount[]
}


model Session {
  id            String    @id @default(uuid())
  userId        String
  refreshSecret String
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}


model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerId])
  @@index([userId])
}

enum Gender {
  male
  female
}
