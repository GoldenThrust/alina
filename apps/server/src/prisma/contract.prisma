model RoutineLog {

  id            String @id @default(cuid())

  userId        String

  routineId     String

  completedAt   DateTime

}

model Product {

  id              String @id @default(cuid())

  name            String

  brand           String

  category        ProductCategory

  description     String

  image           String?

  affiliateUrl    String?

}

model Recommendation {

  id              String @id @default(cuid())

  userId          String

  user            User @relation(fields:[userId], references:[id])

  scanId          String?

  type            RecommendationType

  explanation     String

  productId       String?

  product         Product? @relation(fields:[productId], references:[id])

  createdAt       DateTime @default(now())

}

model Conversation {

  id            String @id @default(cuid())

  userId        String

  user          User @relation(fields:[userId], references:[id])

  createdAt     DateTime @default(now())

  messages      Message[]

}

model Message {

  id            String @id @default(cuid())

  conversationId String

  conversation Conversation @relation(fields:[conversationId], references:[id])

  sender        Sender

  content       String

  createdAt     DateTime @default(now())

}

model Preference {

  id                String @id @default(cuid())

  userId            String @unique

  user              User @relation(fields:[userId], references:[id])

  favoriteBrands    String[]

  favoriteIngredients String[]

  avoidedIngredients String[]

  budget            Int?

}

model Order {

  id              String @id @default(cuid())

  userId          String

  user            User @relation(fields:[userId], references:[id])

  total           Float

  paypalOrderId   String?

  createdAt       DateTime @default(now())

  items           OrderItem[]
}

model OrderItem {

  id            String @id @default(cuid())

  orderId       String

  order         Order @relation(fields:[orderId], references:[id])

  productId     String

  product       Product @relation(fields:[productId], references:[id])

  quantity      Int

}

model ConnectedDevice {

  id            String @id @default(cuid())

  userId        String

  user          User @relation(fields:[userId], references:[id])

  type          DeviceType

  externalId    String

  name          String

}

model Subscription {

  id              String @id @default(cuid())

  userId          String

  user            User @relation(fields:[userId], references:[id])

  plan            SubscriptionPlan

  status          SubscriptionStatus

  startedAt       DateTime

  expiresAt       DateTime?
}


enum Gender {
  MALE
  FEMALE
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RoutinePeriod {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum RecommendationType {
  PRODUCT
  ROUTINE
  HABIT
}

enum Sender {
  USER
  AI
}

enum DeviceType {
  RING
  MOBILE
  WEB
}

enum SubscriptionPlan {
  FREE
  PLUS
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ProductCategory {
  CLEANSER
  TONER
  SERUM
  MOISTURIZER
  SUNSCREEN
  TREATMENT
}