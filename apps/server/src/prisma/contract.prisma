// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName      String
  password  String?
  phoneNumber         String?              
  emailVerifiedAt     DateTime?            
  gender              Gender?
  dateOfBirth         DateTime? 
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  avatar        String?

  skinType      String?
  skinTone      String?

  lastScanImagePath String?

  scans         SkinScan[]
  routines      Routine[]
  conversations Conversation[]
  preferences   Preference?
  subscriptions Subscription[]
  orders        Order[]
  devices       ConnectedDevice[]

  sessions  Session[]
  oauthAccounts       OAuthAccount[]
}


model Session {
  id            String    @id @default(uuid())
  userId        String
  refreshSecret String
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}


model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerId])
  @@index([userId])
}


model SkinScan {
  id              String   @id @default(cuid())

  userId          String
  user            User @relation(fields:[userId], references:[id])

  status          ScanStatus

  score           Float?

  aiSummary       String?

  aiShortSummary  String?

  aiObservation   String?

  aiShortObservation String?

  createdAt       DateTime @default(now())

  // image           ScanImage?

  analysis        SkinAnalysis?

  // metrics         SkinMetric[]
}


