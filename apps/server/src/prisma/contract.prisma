model Routine {

  id            String @id @default(cuid())

  userId        String

  user          User @relation(fields:[userId], references:[id])

  title         String

  period        RoutinePeriod

  title         String

  instruction   String

  position      Int

  accepted       Boolean @default(false)

  createdAt     DateTime @default(now())

}

