<mjml>
  <mj-head>
    <mj-title>YummyHouse Email Change Cancelled</mj-title>
    <mj-preview
      >Your email change request has been successfully cancelled</mj-preview
    >

    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#555555" line-height="1.6" />
      <mj-button
        background-color="#4caf50"
        color="#ffffff"
        border-radius="6px"
      />
    </mj-attributes>

    <mj-style inline="inline"> .container { max-width: 500px; } </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    {{> header }}

    <mj-section
      css-class="container"
      background-color="#ffffff"
      padding="20px"
      border-radius="8px"
    >
      <mj-column>
        <mj-text> Hello {{ name }}, </mj-text>

        <mj-text>
          <strong>✓ Email Change Cancelled</strong>
        </mj-text>

        <mj-text>
          The pending email change for your YummyHouse account has been
          successfully cancelled.
        </mj-text>

        <mj-text>
          Your account email remains unchanged and your account is secure. You
          can continue using your current email address to log in.
        </mj-text>

        <mj-divider border-color="#eeeeee" />

        <mj-text font-size="12px" color="#999999">
          If you did not request this cancellation or have any concerns about
          your account security, please contact our support team immediately.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="10px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#aaaaaa">
          © {{ year }} YummyHouse. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
